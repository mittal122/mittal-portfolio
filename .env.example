# API Configuration (if needed in future)
# VITE_API_URL=https://api.example.com

# Add your environment variables here
# Remember to prefix with VITE_ for Vite projects

# Contact form: Formspree form ID (the part after /f/ in https://formspree.io/f/xxxxxxx).
# Public, not a secret. Without it the form opens the visitor's mail app instead.
VITE_FORMSPREE_ID=
